[Unit]
Description=Bambuddy Touch - Smart Printer Dashboard
After=network.target

[Service]
Type=simple
User=raspberry
WorkingDirectory=/home/raspberry/Bambuddy_Touch
ExecStart=/usr/bin/python3 backend.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target